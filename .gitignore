# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local SQLite database (data-on-disk, not for version control)
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite (stale dev artifact)
local.db

# generated docs snapshot (rebuilt on predev/prebuild)
src/lib/docs/docs.generated.ts
