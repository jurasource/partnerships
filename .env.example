# Companies House API key (free registration required)
# Register at: https://developer.company-information.service.gov.uk/
# -> register application -> REST API key
COMPANIES_HOUSE_API_KEY=

# SQLite database file path (relative to project root)
DATABASE_PATH=./data/app.db

# Phase 2: AI research keys (not needed for Phase 1)
# ANTHROPIC_API_KEY=
# TAVILY_API_KEY=

# Umami analytics (self-hosted at magnet.jurarunner.com)
# Leave empty in .env.local to disable tracking in dev
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Production domain — restricts tracking to this domain only (no localhost noise)
NEXT_PUBLIC_DOMAIN=
